{
  "name": "OpenClinica",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "redhat.telemetry.enabled": false
      },
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "OpenClinica",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "mvn -DskipTests package",
  "postStartCommand": "docker compose -f docker-compose.test.yml up -d",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
